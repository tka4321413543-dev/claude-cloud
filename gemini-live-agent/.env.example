# Copy thành .env rồi điền
GEMINI_API_KEY=
# Bắt buộc đặt, vì server mở ra mạng và đọc được dữ liệu cá nhân của bạn
APP_PASSCODE=

# Để trống: server tự chọn model hỗ trợ Live API và in danh sách ra log.
# Muốn dùng model cụ thể (vd Gemini 3.8 Live) thì copy tên từ log vào đây.
GEMINI_LIVE_MODEL=
# Tên giọng, vd: Puck, Kore, Charon, Aoede (để trống = mặc định)
GEMINI_VOICE=

# Thư mục dữ liệu cá nhân (file .md/.txt/.json/.csv...). Mặc định ./data
DATA_DIR=
# (Tùy chọn) endpoint HTTP của AI agent local. Nhận POST {"question": "..."}
AGENT_URL=

HOST=0.0.0.0
PORT=8000
# (Tùy chọn) bật HTTPS trực tiếp
SSL_CERT=
SSL_KEY=
